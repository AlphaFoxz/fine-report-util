<TableData name="台账" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="acctset"/>
<O>
<![CDATA[5236]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[测试连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT
  p.CONTRACT_CODE AS NM_CODE,
  TRIM(p.PARTYB_NAME) AS PUR_SUPPLIER
FROM TEST.T_CM_CONTRACT_M p
WHERE p.ACCTSET_CODE = '${acctset}'
ORDER BY p.CONTRACT_CODE]]></Query>
